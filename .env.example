# cloud-security-checks settings. Copy to .env and fill in what you use. Real environment
# variables always win over this file. Never commit .env.

# --- AWS ---------------------------------------------------------------------------------------
# Usually nothing is needed here: use --profile, 'aws sso login', or an IAM role.
# AWS_PROFILE=audit
# Regions to scan, comma-separated (default: every enabled region).
AWS_REGIONS=

# --- Azure -------------------------------------------------------------------------------------
# Pick one: secret | managed_identity | cli. Left empty: a client secret if one is set, else a
# managed identity if USE_MANAGED_IDENTITY=true, else your 'az login' session.
AZURE_AUTH=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
USE_MANAGED_IDENTITY=false
# Subscriptions to scan, comma-separated (default: every subscription the identity can read).
AZURE_SUBSCRIPTION_IDS=
# Sovereign clouds only:
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.us
# AZURE_ARM_BASE_URL=https://management.usgovcloudapi.net

# --- Google Cloud ------------------------------------------------------------------------------
# Usually nothing is needed here: use 'gcloud auth login' (optionally with --impersonate).
# Projects to scan, comma-separated (default: every active project the identity can list).
GCP_PROJECT_IDS=
# When signed in as a user, the project that API quota is charged to.
GCP_QUOTA_PROJECT=
# A token you already hold (for example from workload identity federation in CI).
# GOOGLE_OAUTH_ACCESS_TOKEN=

HTTP_TIMEOUT_SECONDS=30
